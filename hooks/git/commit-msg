#!/bin/bash
# Git commit-msg hook: auto-bump plugin.json version on [release] commits.
# Prevents version mismatch between local plugin.json and published cache.
#
# Install: bash hooks/git/setup-hooks.sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

if ! echo "$COMMIT_MSG" | grep -q '\[release\]'; then
  exit 0
fi

PLUGIN_JSON="$(git rev-parse --show-toplevel)/.claude-plugin/plugin.json"
if [ ! -f "$PLUGIN_JSON" ]; then
  exit 0
fi

CURRENT=$(node -e "console.log(JSON.parse(require('fs').readFileSync(process.argv[1],'utf8')).version)" "$PLUGIN_JSON" 2>/dev/null)
if [ -z "$CURRENT" ]; then
  exit 0
fi

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"
NEW_VERSION="$MAJOR.$MINOR.$((PATCH + 1))"

node -e "
const fs = require('fs');
const p = process.argv[1];
const d = JSON.parse(fs.readFileSync(p, 'utf8'));
d.version = process.argv[2];
fs.writeFileSync(p, JSON.stringify(d, null, 2) + '\n');
" "$PLUGIN_JSON" "$NEW_VERSION" 2>/dev/null

git add "$PLUGIN_JSON"

echo "skill-engine: bumped version $CURRENT -> $NEW_VERSION"
